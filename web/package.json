{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "node scripts/build-tokens.mts && node scripts/build-scale.mts && node scripts/sync-vault-assets.mjs && node scripts/build-sw.mjs",
    "prebuild": "node scripts/build-tokens.mts && node scripts/build-scale.mts && node scripts/sync-vault-assets.mjs && node scripts/build-sw.mjs",
    "build:sw": "node scripts/build-sw.mjs",
    "tokens": "node scripts/build-tokens.mts",
    "tokens:check": "node scripts/build-tokens.mts --check",
    "og": "node scripts/render-og.mjs",
    "icons": "node scripts/render-icons.mjs",
    "scale": "node scripts/build-scale.mts",
    "scale:check": "node scripts/build-scale.mts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:status": "node --env-file-if-exists=.env.local scripts/db-status.mjs",
    "db:seed-exercises": "node --env-file-if-exists=.env.local scripts/seed-exercises.mts",
    "shots": "node --env-file-if-exists=.env.local scripts/shots.mjs",
    "paint": "node --env-file-if-exists=.env.local scripts/paint-cost.mjs",
    "e2e": "npm run build && node --env-file-if-exists=.env.local scripts/e2e-offline.mjs",
    "e2e:degraded": "npm run build && node --env-file-if-exists=.env.local scripts/e2e-degraded.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "bundle": "node scripts/bundle-budget.mjs",
    "shots:save": "node scripts/shots-compare.mjs save",
    "shots:compare": "node scripts/shots-compare.mjs compare",
    "freeze": "node scripts/freeze.mjs",
    "images": "node scripts/image-cost.mjs",
    "vault:cost": "node --env-file-if-exists=.env.local scripts/vault-cost.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@google/genai": "^2.18.0",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/rest": "^22.0.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@types/mdast": "^4.0.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "ical.js": "^2.2.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.33.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
