# Copy to .env.local (gitignored) and fill in real values. Never commit .env.local.
# The same names go into Vercel -> Project Settings -> Environment Variables.

# --- Session signing (required for the private site) ----------------------
# Any 32+ character random string. Changing it signs everyone out, which is also
# how you revoke a stolen session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- GitHub Contents API (vault writes) -----------------------------------
# Fine-grained PAT, scoped to ONLY the 2ndMind repo, "Contents: Read and write".
# github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# --- Site URL -------------------------------------------------------------
# Drives OpenGraph URLs, the sitemap, and — importantly — the WebAuthn relying-party
# ID. A mismatch between this and the browser's real origin makes passkeys fail with
# an error that explains nothing. Leave unset for localhost.
# NEXT_PUBLIC_SITE_URL=https://victorgusev.com
# The hostname here is the WebAuthn relying party. Changing it invalidates every
# enrolled passkey, so it is not just a canonical-URL setting.

# --- Passkeys (enrolled credentials) ---------------------------------------
# There is no user table. Credentials are not secret: the private key never leaves your
# authenticator. As of the move to Postgres (D-234), enrolled devices live in the
# `passkey_credentials` table, not here — enrolling a device via /signin/register writes
# a row directly, with no env edit and no redeploy.
#
# These remain as a fallback ONLY, honoured so the device enrolled before the migration is
# never lost. Leave them exactly as they already are (or unset, on a fresh setup) and do
# not add new devices here — use /signin/register instead.
PASSKEYS=
PASSKEY_CREDENTIAL_ID=
PASSKEY_PUBLIC_KEY=

# --- Passkey enrolment gate -----------------------------------------------
# Registration is DISABLED unless this is set and supplied by the caller. Unlike the old
# one-shot flow, this is meant to stay set PERMANENTLY — it is what makes enrolment
# self-serve. Pick a long random string, save it somewhere durable (a password manager),
# and set it here and in Vercel once.
#
# To enrol a device: visit /signin/register, paste this value, name the device, and
# complete the passkey prompt. The credential is usable immediately — nothing to copy
# anywhere, no redeploy. Knowing this secret only opens the registration ceremony; a real
# WebAuthn assertion is still required to produce a credential.
PASSKEY_REGISTRATION_SECRET=

# --- Neon Postgres (Athletics) --------------------------------------------
# Neon dashboard -> project -> Connect -> connection string.
#
# Either the pooled or the direct string works. The app talks to Neon over
# @neondatabase/serverless's HTTP driver, which opens no long-lived connection and so has
# no pool to exhaust; `npm run db:migrate` is the one path that uses a websocket, and it
# runs once from a laptop rather than from a function.
#
# After setting this, create the tables:  npm run db:migrate
# Without it, /private/athletics explains itself and the rest of the site is unaffected.
DATABASE_URL=

# --- Calendar feeds (feature 4, shipped 2026-08-22) -----------------------
# Private iCal URLs. No OAuth, no consent screen, no cost.
#   Google Calendar -> Settings -> your calendar -> "Secret address in iCal format"
#   Canvas          -> Calendar  -> "Calendar Feed"
# Both grant read access to your schedule to anyone holding the URL, so treat them as
# secrets: they belong here and in Vercel, never in a commit or a chat message.
# GOOGLE_CALENDAR_KEY=
# CANVAS_CALENDAR=

# Phase 3 AI Summary
GEMINI_API_KEY=your_temp_key_here

# --- Applications sheet (feature 7.6) -------------------------------------
# Google Sheet -> File -> Share -> Publish to web -> the applications tab -> CSV -> Publish.
#
# THIS URL IS A CREDENTIAL. Anyone holding it can read the sheet, so it belongs here and in
# Vercel and never in the repository — same treatment as GOOGLE_CALENDAR_KEY.
#
# Unset is fine: /private/work says so and everything else on the page still works. The app
# only ever reads this sheet; the Gmail script remains the only thing that writes to it.
JOB_SHEET_CSV_URL=
