# Copy to .env.local (gitignored) and fill in real values. Never commit .env.local.
# Same names go into Vercel → Project Settings → Environment Variables at deploy time.

# --- GitHub Contents API (vault writes — Days 16-20) ---------------------
# Fine-grained PAT, scoped to ONLY the 2ndMind repo, "Contents: Read and write" permission.
# github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# --- Neon Postgres (Athletics — Days 21-29) -------------------------------
# Neon dashboard → your project → Connect → pooled connection string.
DATABASE_URL=

# --- Session auth (self-hosted WebAuthn — Days 16-20) ---------------------
# Random 32+ byte secret for signing the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
